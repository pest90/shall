{
  // Merge into .vscode/tasks.json of the folder opened in VSCode; drop
  // "isDefault" if another task is the default build task.
  //
  // Paths in the output are relative to the project, or to the shall
  // workspace root for a member: open that folder. For a project in a
  // subfolder, set "cwd" and the base of "fileLocation" (its second
  // element) both to "${workspaceFolder}/<folder>".
  //
  // "shall: new item": run it while a requirements file is open; the new
  // item is appended to that file.
  // "shall: check": puts every defect into the Problems panel, warnings
  // as warnings; it is also the default build task (Ctrl+Shift+B).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "shall: new item",
      "type": "process",
      "command": "shall",
      "args": [
        "new",
        "${input:type}",
        "${input:title}",
        "--file",
        "${file}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "shall: check",
      "type": "process",
      "command": "shall",
      "args": ["check"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": {
        "owner": "shall",
        "source": "shall",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+): (?:(warning): )?(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "type",
      "type": "promptString",
      "description": "Item type, a level from shall.toml (e.g. swr, dsn)"
    },
    {
      "id": "title",
      "type": "promptString",
      "description": "Title of the new item"
    }
  ]
}
